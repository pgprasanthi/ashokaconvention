PORT=8787

# OAuth client ID from Google Cloud Console (Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ID of the Google Sheet holding the team roster (admin/staff, plus profile
# details). Found in the sheet's URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
# Columns: Email | Role | Name | Joining Date | Mobile, starting at row 2
# (row 1 = headers). Anyone not listed is treated as a guest.
# Must be shared as Editor with the service account's client_email, since the
# admin panel adds/edits/removes rows, not just reads them.
GOOGLE_SHEETS_ID=your-sheet-id

# Path to the downloaded service account JSON key (relative to server/)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-service-account.json

# Tab name + range within the sheet
TEAM_RANGE=Sheet1!A2:E

# How long to cache the team list before re-fetching from the sheet
TEAM_CACHE_TTL_MS=300000

# Google Calendar used for venue bookings. Found in that calendar's
# Settings and sharing > Integrate calendar > Calendar ID.
# Must be shared with the service account's client_email with
# "Make changes to events" permission.
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Origin the frontend is served from, so CORS + cookies can be locked to it
CLIENT_ORIGIN=http://localhost:5173

# WhatsApp webhook (Meta -> this backend, via Dualhook's Embedded Signup flow).
# WHATSAPP_WEBHOOK_VERIFY_TOKEN: a secret you make up yourself, entered
# identically in Dualhook/Meta's webhook config. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WHATSAPP_WEBHOOK_SECRET_PATH: a long random URL segment (same generator as
# above). Real HMAC signature verification isn't possible under Dualhook's
# managed Embedded Signup flow - Meta signs payloads with Dualhook's own Meta
# App secret, not ours - so this confidential path plus the WABA/phone number
# check in whatsappRoutes.js is the substitute protection instead. The actual
# webhook URL to give Dualhook/Meta is:
#   https://<backend-host>/api/whatsapp/webhook/<this value>
# WHATSAPP_WABA_ID: from Meta Business Suite -> Business Settings -> Accounts
# -> WhatsApp Accounts.
# WHATSAPP_PHONE_NUMBER_ID: from Meta App dashboard -> WhatsApp -> API Setup
# (a different ID from the WABA ID above).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-string
WHATSAPP_WEBHOOK_SECRET_PATH=replace-with-another-long-random-string
WHATSAPP_WABA_ID=your-whatsapp-business-account-id
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
