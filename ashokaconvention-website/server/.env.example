PORT=8787

# OAuth client ID from Google Cloud Console (Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated list of emails that should be treated as admins; everyone else who
# signs in is a guest
ADMIN_EMAILS=owner@example.com,manager@example.com

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Origin the frontend is served from, so CORS + cookies can be locked to it
CLIENT_ORIGIN=http://localhost:5173
